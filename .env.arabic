# ==============================================================================
# إعدادات الموديل العربي - Arabic Model Configuration
# هذا الملف خاص بالموديل العربي للبحث والأسئلة باللغة العربية
# ==============================================================================

# ── Ollama Configuration (Arabic Model) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_GPU=0
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=60m
OLLAMA_MAX_RETRIES=2

# ── LLM Backend Selection ──
LLM_BACKEND=ollama

# ── Neo4j Configuration (Knowledge Graph) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_TIMEOUT_SECONDS=5
USE_GRAPH=true

# ── Storage & Directory Paths ──
PDF_DIR=pdfs
METADATA_FILE=pdfs/metadata.csv
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma_db
SQLITE_DB_PATH=data/graph_rag.db
UPLOAD_TEMP_DIR=data/temp_uploads

# ── Ingestion & Document Processing ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=200

# ── Context Limits for LLM (Arabic needs more context) ──
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARS=5000

# ── JWT Authentication ──
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── RAG Evaluation Settings ──
RAG_EVAL_ENABLED=true

# ── Application & Logging ──
APP_HOST=localhost
APP_PORT=8501
LOG_LEVEL=INFO
APP_LOG_FILE=data/app.log

# ── Arabic Model Specific Settings ──
ARABIC_MODEL_ENABLED=true
ARABIC_PROMPT_LANGUAGE=arabic
ARABIC_RESPONSE_LANGUAGE=arabic
