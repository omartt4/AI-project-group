# ==============================================================================
# Graph RAG Chatbot - Environment Configuration Template
# Copy this file to .env and customize values for your environment.
# All values are loaded securely via python-dotenv into config.py.
# ==============================================================================

# ── Ollama Configuration (Local LLM & Embeddings) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Neo4j Configuration (Knowledge Graph) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ── Storage & Directory Paths ──
PDF_DIR=pdfs
METADATA_FILE=pdfs/metadata.csv
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma_db
SQLITE_DB_PATH=data/graph_rag.db
UPLOAD_TEMP_DIR=data/temp_uploads

# ── Ingestion & Document Processing ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=200

# ── JWT Authentication ──
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── RAG Evaluation Settings ──
RAG_EVAL_ENABLED=true

# ── Application & Logging ──
APP_HOST=localhost
APP_PORT=8501
LOG_LEVEL=INFO
APP_LOG_FILE=data/app.log
