# ==============================================================================
# Graph RAG — Environment Configuration Template
# Copy this file to .env and replace placeholder values locally.
# Never commit the real .env file.
# ==============================================================================


OCR_LANGUAGES=eng+ara
# ── OpenRouter API ─────────────────────────────────────────────────────────────
MODEL_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Model routing by task
OPENROUTER_EXTRACTION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_EVAL_MODEL=google/gemma-4-31b-it:free
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# Qwen3 Embedding 8B dimensions
EMBEDDING_DIMENSIONS=4096

MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_RETRIES=2
LANGCHAIN_MAX_CONCURRENCY=4

# Optional OpenRouter application metadata
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Graph RAG Studio


# ── Neo4j Aura Instance ───────────────────────────────────────────────────────
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=


# ── Storage and Data ──────────────────────────────────────────────────────────
PDF_DIR=pdfs
METADATA_FILE=pdfs/metadata.csv
DATA_DIR=data
EXTRACTION_CACHE_DIR=data/extraction_cache
GRAPH_EXTRACTION_MAX_CHARS=14000

CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=research_papers_graph_v2

SQLITE_DB_PATH=data/graph_rag.db
UPLOAD_TEMP_DIR=data/temp_uploads


# ── Ingestion and Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
OCR_DPI=200
OCR_LANGUAGES=eng+ara
MAX_UPLOAD_SIZE_MB=200

GRAPH_SCHEMA_VERSION=3
EXTRACTION_VERSION=graph-v3-paper-level
DATASET_ID=research-v2


# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-random-secure-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24


# ── RAG Evaluation ────────────────────────────────────────────────────────────
RAG_EVAL_ENABLED=true


# ── Application and Logging ───────────────────────────────────────────────────
APP_HOST=localhost
APP_PORT=8501
LOG_LEVEL=INFO
APP_LOG_FILE=data/app.log
