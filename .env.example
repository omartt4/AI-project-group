# ==============================================================================
# Graph RAG — Environment Configuration Template
# Copy this file to .env and replace placeholder values locally.
# Never commit the real .env file.
# ==============================================================================

# ── OpenRouter API ─────────────────────────────────────────────────────────────
MODEL_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Model routing by task
OPENROUTER_EXTRACTION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_EVAL_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_DIMENSIONS=4096

MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_RETRIES=2
LANGCHAIN_MAX_CONCURRENCY=4

# Optional OpenRouter application metadata
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Graph RAG Studio


# ── Neo4j Aura Instance ───────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://5da6043c.databases.neo4j.io
NEO4J_USERNAME=5da6043c
NEO4J_PASSWORD=
NEO4J_DATABASE=5da6043c
AURA_INSTANCEID=5da6043c
AURA_INSTANCENAME=latest_graph



# ── Storage and Data ──────────────────────────────────────────────────────────
PDF_DIR=pdfs
METADATA_FILE=pdfs/metadata.csv
DATA_DIR=data
EXTRACTION_CACHE_DIR=data/extraction_cache
GRAPH_EXTRACTION_MAX_CHARS=14000
EXTRACTION_SEGMENT_MAX_CHARS=20000
EXTRACTION_OUTPUT_TOKENS=8192
# Keep extraction JSON concise and complete. This does not affect the chat model.
EXTRACTION_REASONING_ENABLED=false
EXTRACTION_SEGMENT_RETRY_DEPTH=2
EXTRACTION_BATCH_MAX_FAILURE_RATIO=0.50

CHROMA_PERSIST_DIR=data/chroma_db
# Use a new collection whenever the embedding model changes; do not mix
# vectors produced by different embedding models in one collection.
CHROMA_COLLECTION_NAME=documents_nemotron_v1

SQLITE_DB_PATH=data/graph_rag.db
UPLOAD_TEMP_DIR=data/temp_uploads


# ── Ingestion and Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
OCR_DPI=200
OCR_LANGUAGES=eng+ara
OCR_ENGINE=paddle
OCR_FALLBACK_ENGINE=tesseract
PADDLE_OCR_LANGUAGE=ar
PADDLE_OCR_URL=http://localhost:8001
PADDLE_OCR_TIMEOUT_SECONDS=300
SURYA_OCR_COMMAND=surya_ocr
SURYA_OCR_TIMEOUT_SECONDS=300
MAX_UPLOAD_SIZE_MB=200

GRAPH_SCHEMA_VERSION=3
EXTRACTION_VERSION=graph-v3-paper-level
DATASET_ID=research-v2


# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-random-secure-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24


# ── RAG Evaluation ────────────────────────────────────────────────────────────
RAG_EVAL_ENABLED=true


# ── Application and Logging ───────────────────────────────────────────────────
APP_HOST=localhost
APP_PORT=8501
LOG_LEVEL=INFO
APP_LOG_FILE=data/app.log
