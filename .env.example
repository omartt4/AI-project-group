# ==============================================================================
# Graph RAG Chatbot - Environment Configuration Template
# Copy this file to .env and customize values for your environment.
# All values are loaded securely via python-dotenv into config.py.
# ==============================================================================

OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LAB_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
LAB_EMBED_MODEL_ALT=nvidia/nemotron-3.5-embed-8b:free
LAB_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
LAB_RERANK_MODEL=
LAB_REQUESTS_PER_MIN=10
LAB_EMBED_DIM=
LAB_QUERY_PREFIX=
LAB_EXTRACT_ENTITIES=true
LAB_ENTITY_EXTRACTOR=yake
LAB_MAX_ENTITIES_PER_CHUNK=8
LAB_ENTITY_BOOST=0.15

# ── Neo4j Configuration (Knowledge Graph) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ── Storage & Directory Paths ──
PDF_DIR=pdfs
METADATA_FILE=pdfs/metadata.csv
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma_db
SQLITE_DB_PATH=data/graph_rag.db
UPLOAD_TEMP_DIR=data/temp_uploads

# ── Ingestion & Document Processing ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=200

# ── JWT Authentication ──
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── RAG Evaluation Settings ──
RAG_EVAL_ENABLED=true

# ── Application & Logging ──
APP_HOST=localhost
APP_PORT=8501
LOG_LEVEL=INFO
APP_LOG_FILE=data/app.log
